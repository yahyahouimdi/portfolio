---
import { sectionContent, work } from "../config.ts";

const entries = Object.entries(work);

const resolveLink = (url: string) => {
  return url;
};
---

<section class="portfolio section-card" id="projects">
  <header class="section-heading">
    <div>
      <h2 class="article-title">{sectionContent.projects.heading}</h2>
    </div>
  </header>

  <div class="work-sections">
    {
      entries.map(([category, group]) => (
        <section class="work-category" id={category}>
          <h3 class="h3 work-category-title">{category.replaceAll("-", " ")}</h3>
          <ul class="project-list" data-view={group.view}>
            {group.items.map((item) => (
              <li class="project-item">
                <a
                  href={resolveLink(item.link)}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <figure class="project-img">
                    <img src={item.pic} alt={item.name} loading="lazy" />
                  </figure>

                  <div class="project-info">
                    <h3 class="project-title">{item.name}</h3>
                    {group.view === "list" && "description" in item && (
                      <>
                        <p class="project-description">{item.description}</p>
                        {item.tags && item.tags.length > 0 && (
                          <ul class="project-tags">
                            {item.tags.map((tag) => (
                              <li class="project-tag">{tag}</li>
                            ))}
                          </ul>
                        )}
                      </>
                    )}
                  </div>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</section>

<style>
  .portfolio {
    display: grid;
    gap: 1.2rem;
  }

  .categories {
    display: grid;
    gap: 1rem;
  }

  .items-list {
    display: flex;
    gap: 0.6rem;
    overflow-x: auto;
    scrollbar-width: none;
    padding-bottom: 0.15rem;
  }

  .items-list::-webkit-scrollbar {
    display: none;
  }

  .category {
    margin-bottom: 0;
  }

  .category button {
    color: var(--text-muted);
    text-transform: capitalize;
    padding: 0.52rem 0.9rem;
    border-radius: var(--radius-pill);
    border: 1px solid transparent;
    background: transparent;
    font-size: var(--fs-7);
    font-weight: var(--fw-600);
    transition:
      color var(--transition-1),
      background-color var(--transition-1),
      border-color var(--transition-1),
      transform var(--transition-1),
      box-shadow var(--transition-1);
  }

  .category button:hover,
  .category button:focus-visible {
    color: var(--text-primary);
    background: var(--bg-elevated);
    border-color: var(--border-subtle);
    transform: translateY(-1px);
  }

  .category button.active {
    color: var(--accent);
    background: var(--accent-soft);
    border-color: var(--border-strong);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--accent) 18%, transparent);
  }

  .select-value,
  .project-title {
    text-transform: capitalize;
  }

  .project-list[hidden] {
    display: none !important;
  }

  .project-list {
    margin-bottom: 0;
  }

  .project-item {
    --reveal-index: 0;
  }

  .project-list.is-revealing .project-item {
    animation: work-card-reveal 300ms cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: calc(var(--reveal-index) * 28ms);
  }

  .project-list.is-revealing .project-item > a {
    pointer-events: none;
  }

  .project-list.is-revealed .project-item > a {
    pointer-events: auto;
  }

  .project-list a {
    color: inherit;
    display: block;
  }

  .project-img {
    position: relative;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid var(--border-subtle);
  }

  .project-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-1);
    display: block;
  }

  .project-img::before {
    content: "";
    position: absolute;
    inset: 0;
    background: transparent;
    z-index: 1;
    transition: background-color var(--transition-1);
  }

  .project-title {
    color: var(--text-primary);
    font-size: var(--fs-5);
    font-weight: var(--fw-600);
    line-height: 1.3;
  }

  .project-list[data-view="grid"] {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 0.9rem;
  }

  .project-list[data-view="grid"] .project-img {
    height: 180px;
    width: 100%;
    margin-bottom: 0.7rem;
  }

  .project-list[data-view="list"] {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }

  .project-list[data-view="list"] .project-item > a {
    display: flex;
    gap: 0.9rem;
    align-items: flex-start;
    background: color-mix(in srgb, var(--bg-elevated) 80%, transparent);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 0.85rem;
    box-shadow: var(--shadow-1);
    transition:
      transform var(--transition-1),
      box-shadow var(--transition-1),
      border-color var(--transition-1);
  }

  .project-list[data-view="grid"] .project-item > a {
    background: color-mix(in srgb, var(--bg-elevated) 80%, transparent);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 0.72rem;
    transition:
      transform var(--transition-1),
      border-color var(--transition-1),
      box-shadow var(--transition-1);
  }

  .project-item > a:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-2);
    border-color: var(--border-strong);
  }

  .project-item > a:focus-visible {
    transform: translateY(-2px);
    box-shadow: var(--shadow-2);
    border-color: var(--border-strong);
  }

  .project-item > a:hover .project-img::before {
    background-color: var(--image-overlay);
  }

  .project-item > a:hover .project-img img {
    transform: scale(1.04);
  }

  .project-list[data-view="list"] .project-img {
    flex-shrink: 0;
    width: 130px;
    height: 96px;
  }

  .project-list[data-view="list"] .project-info {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }

  .project-list[data-view="list"] .project-title {
    font-size: var(--fs-5);
  }

  .project-description {
    color: var(--text-secondary);
    font-size: var(--fs-7);
    font-weight: var(--fw-300);
    line-height: 1.55;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 2px;
  }

  .project-tag {
    color: var(--accent);
    background: var(--accent-soft);
    border: 1px solid
      color-mix(in srgb, var(--accent) 25%, var(--border-subtle));
    border-radius: 999px;
    font-size: var(--fs-8);
    padding: 3px 10px;
    line-height: 1.4;
    font-weight: var(--fw-500);
  }

  @keyframes work-card-reveal {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 579px) {
    .project-list[data-view="list"] .project-item > a {
      flex-direction: column;
    }

    .project-list[data-view="list"] .project-img {
      width: 100%;
      height: 160px;
    }
  }

  @media (min-width: 1024px) {
    .project-list[data-view="grid"] {
      grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
      gap: 1rem;
    }

    .project-list[data-view="grid"] .project-img {
      height: 190px;
    }
  }
</style>

<script>
  const portfolio = document.querySelector<HTMLElement>("#work");
  if (portfolio) {
    const buttons = Array.from(
      portfolio.querySelectorAll<HTMLButtonElement>("button[data-filter-btn]"),
    );
    const sections = Array.from(
      portfolio.querySelectorAll<HTMLElement>("[data-category]"),
    );
    const reducedMotionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");
    const initialCategory =
      buttons.find((button) => button.getAttribute("aria-selected") === "true")
        ?.dataset.filterBtn ?? buttons[0]?.dataset.filterBtn ?? "";
    let activeCategory = "";

    const applyCardReveal = (section: HTMLElement, animate: boolean) => {
      section.classList.remove("is-revealing", "is-revealed");
      const items = Array.from(section.querySelectorAll<HTMLElement>(".project-item"));

      items.forEach((item, index) => {
        item.style.setProperty("--reveal-index", String(index));
      });

      if (!animate || reducedMotionQuery.matches || items.length === 0) {
        section.classList.add("is-revealed");
        return;
      }

      section.classList.add("is-revealing");

      const totalDelay = Math.min(items.length, 10) * 28 + 320;
      window.setTimeout(() => {
        section.classList.remove("is-revealing");
        section.classList.add("is-revealed");
      }, totalDelay);
    };

    const setCategory = (category: string, animate = true) => {
      if (!category || category === activeCategory) {
        return;
      }

      activeCategory = category;

      buttons.forEach((button) => {
        const isActive = button.dataset.filterBtn === category;
        button.classList.toggle("active", isActive);
        button.setAttribute("aria-selected", isActive ? "true" : "false");
        button.tabIndex = isActive ? 0 : -1;
      });

      const nextSection = sections.find(
        (section) => section.dataset.category === category,
      );
      if (!nextSection) {
        return;
      }

      sections.forEach((section) => {
        const isActive = section === nextSection;
        section.hidden = !isActive;
        section.tabIndex = isActive ? 0 : -1;
        if (!isActive) {
          section.classList.remove("is-revealing", "is-revealed");
        }
      });

      applyCardReveal(nextSection, animate);
    };

    if (initialCategory) {
      setCategory(initialCategory, false);
    }

    portfolio.addEventListener("click", (event) => {
      const target = event.target as HTMLElement;
      const button = target.closest<HTMLButtonElement>(
        "button[data-filter-btn]",
      );
      const category = button?.dataset.filterBtn;
      if (!category) {
        return;
      }
      setCategory(category);
    });

    portfolio.addEventListener("keydown", (event) => {
      const target = event.target as HTMLElement;
      const currentTab =
        target.closest<HTMLButtonElement>("button[role='tab']");
      if (!currentTab) {
        return;
      }

      const currentIndex = buttons.indexOf(currentTab);
      if (currentIndex < 0) {
        return;
      }

      let nextIndex = currentIndex;
      switch (event.key) {
        case "ArrowRight":
        case "ArrowDown":
          nextIndex = (currentIndex + 1) % buttons.length;
          break;
        case "ArrowLeft":
        case "ArrowUp":
          nextIndex = (currentIndex - 1 + buttons.length) % buttons.length;
          break;
        case "Home":
          nextIndex = 0;
          break;
        case "End":
          nextIndex = buttons.length - 1;
          break;
        default:
          return;
      }

      event.preventDefault();
      const nextButton = buttons[nextIndex];
      const nextCategory = nextButton?.dataset.filterBtn;
      if (!nextButton || !nextCategory) {
        return;
      }
      setCategory(nextCategory);
      nextButton.focus();
    });
  }
</script>
