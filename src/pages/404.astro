---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page not found | Yahya Houimdi">
  <main class="not-found">
    <p class="eyebrow">404</p>
    <h1>This page wandered off.</h1>
    <p>The page you requested does not exist, but the portfolio is still here.</p>
    <a class="home-link" href="/portfolio/">Return to portfolio</a>
  </main>
</Layout>

<style>
  .not-found {
    min-height: 100vh;
    display: grid;
    place-content: center;
    gap: 1rem;
    max-width: 34rem;
    padding: 2rem;
    margin: auto;
    text-align: center;
  }

  .eyebrow {
    color: var(--accent);
    font-weight: var(--fw-700);
    letter-spacing: 0.12em;
  }

  h1 {
    font-size: var(--fs-1);
    color: var(--text-primary);
  }

  .not-found p:not(.eyebrow) {
    color: var(--text-muted);
  }

  .home-link {
    justify-self: center;
    margin-top: 0.75rem;
    padding: 0.7rem 1rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    background: var(--accent-soft);
    color: var(--accent);
    font-weight: var(--fw-600);
  }
</style>
